# ============================================================
#  LeadPulse CA — Environment Variables Template
#  Copy this file to .env and fill in your real values.
#  NEVER commit .env to Git.
# ============================================================

# ─── DATABASE (Phase 1) ──────────────────────────────────────
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.YOUR-PROJECT.supabase.co:5432/postgres"
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key-here"

# ─── APP ─────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# ─── CRON / API SECURITY ─────────────────────────────────────
# Protects /api/cron/run, /api/cron/score and /api/fetch/trigger.
# Generate with: openssl rand -hex 32
CRON_SECRET="generate-a-random-32-char-secret"
# Same value — NEXT_PUBLIC_ prefix makes it available in the Run Cycle button
NEXT_PUBLIC_CRON_SECRET="generate-a-random-32-char-secret"

# ─── OPENAI / GROQ (added in Phase 4) ────────────────────────
# Groq keys start with gsk_  |  OpenAI keys start with sk-
OPENAI_API_KEY="gsk_..."

# ─── RAPIDAPI (added in Phase 3) ─────────────────────────────────────────────
# Single key used by all RapidAPI fetchers:
#   Twitter  → twitter-api45.p.rapidapi.com
#   Facebook → facebook-scraper3.p.rapidapi.com
#   Reddit   → reddit34.p.rapidapi.com
RAPIDAPI_KEY="your-rapidapi-key-here"

# ─── REDIS / UPSTASH (optional, Phase 5+) ────────────────────
UPSTASH_REDIS_REST_URL="https://your-endpoint.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-token"
UPSTASH_REDIS_URL="rediss://default:TOKEN@your-endpoint.upstash.io:6379"

# ─── FETCH CONFIG (safe defaults) ────────────────────────────
FETCH_INTERVAL_HOURS=24
MIN_INTENT_SCORE=6
BATCH_SIZE_KEYWORDS=50
OPENAI_BATCH_SIZE=20
MAX_KEYWORDS_PER_RUN=500
